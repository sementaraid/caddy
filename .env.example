# Copy to .env (never commit it) and fill in. Keep the single quotes:
# bcrypt hashes contain `$`, which docker compose would otherwise try to expand.
#
# Create the hash with:
#   docker run --rm -it caddy:2 caddy hash-password
SIGNALS_USER=admin
SIGNALS_PASSWORD_HASH='$2a$14$replace.this.with.your.own.hash.............................'
